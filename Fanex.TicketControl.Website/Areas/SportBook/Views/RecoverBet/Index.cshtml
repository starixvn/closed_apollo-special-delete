@{
    ViewBag.Title = Labels.TitlePage;
}
@using Fanex.TicketControl.Core.Resources
@model Fanex.TicketControl.SportBook.Criteria.GetSingleBetCriteria
@section Head {
    <link href="~/Scripts/_Libs/TimePicker/jquery-ui-timepicker-addon.css" rel="stylesheet"
        type="text/css" />
}
@section Styles {
    <link href="~/Areas/SportBook/Styles/VoidSingleBet.less" rel="stylesheet" type="text/css" />
}
@section Headline {
    <div class="title">
        <a href="~/">Home</a> / Recover Ticket
    </div>
}
@using (Html.BeginForm("Index", "RecoverBet", FormMethod.Post, new { id = "RecoverBetForm" }))
{
    <div class="filter-bar">
        <div class="filter-bar-inner">
            <div class="filter-row">
                <div class="filter-cell">
                    <div class="lbl-field span">
                        <label for="txtBetId">
                            BetID</label>
                    </div>
                    <div class="edit-field span3">
                        <input type="text" id="txtBetId" maxlength="19" value="" />
                    </div>
                </div>
                <div class="filter-cell">
                    <div class="lbl-field span3">
                        <input type="button" value="Search" class="submit" id="btnSearch" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="report-content">
        <div class="display-none content-grid">
            <div class="freegrid " id="matchInfo">
            </div>
        </div>
        <div class="display-none content-grid">
            <div class="freegrid " id="ticketInfo">
            </div>
        </div>
        @Html.Partial("_Message")
    </div>
}
@section Foot {
    @Scripts.Render("~/areas/SportBook/RecoverBet")
}