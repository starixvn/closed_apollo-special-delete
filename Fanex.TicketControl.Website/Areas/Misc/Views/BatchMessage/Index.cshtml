@{
    ViewBag.Title = Labels.TitlePage;
}
@using Fanex.TicketControl.Core.Resources
@using Fanex.TicketControl.Core.DTO
@model Fanex.TicketControl.Misc.Criteria.GetTicketsListingCriteria
@section Styles {
    <link href="~/Areas/Misc/Styles/BatchMessage.less" rel="stylesheet" type="text/css" />
}
@section Headline {
    <div class="title">
        <a href="~/">@Labels.Home</a> / @Labels.Update_Batch_Message
    </div>
}
@using (Html.BeginForm("Index", "BatchMessage", FormMethod.Post, new { id = "BatchMessageForm" }))
{

    <div class="filter-bar">
        <div class="filter-bar-inner">
            <div class="filter-row">
                <div class="filter-cell">
                    <div class="lbl-field span">
                        <label for="TransId" id="betId">
                            BetID(s)</label>
                    </div>
                    <div class="edit-field span8" style="width: 800px;">
                        <div class="span6 offset number-group">
                            <input class="text-number" id="TransId" />
                        </div>
                        <div class="float-left">
                            <p id="errorBetId" style="margin-top: -22px;">
                                &nbsp;
                            </p>
                            Ex: 12345678,12345679,12345680</div>
                        <div class="float-right em" style="width: 90px;">
                            Max: 100 bets</div>
                    </div>
                </div>
            </div>
            <div class="filter-row">
                <div class="filter-cell">
                </div>
            </div>
            <div class="filter-row">
                <div class="filter-cell">
                </div>
            </div>
            <div class="filter-row">
                <div class="filter-cell">
                    @Html.Partial("_Message")
                </div>
            </div>
            <div class="filter-row">
                <div class="filter-cell">
                    <input type="button" id="btnSearch" class="submit" value="@Labels.Update_Batch_Message" />
                </div>
            </div>
        </div>
    </div>

}
@section Foot {
    @Scripts.Render("~/areas/misc/BatchMessage")
}